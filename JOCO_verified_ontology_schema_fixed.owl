  <rdf:Description rdf:about="http://example.org/ocosl-ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>OCOSL ontology schema for ontology-constrained semantic image labeling</rdfs:label>
    <dcterms:description>Verified release ontology used to document the OCOSL framework.</dcterms:description>
    <ex:upperLevelClassCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</ex:upperLevelClassCount>
    <ex:canonicalConceptCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">197</ex:canonicalConceptCount>
    <ex:totalClassCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">214</ex:totalClassCount>
    <ex:objectPropertyCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38</ex:objectPropertyCount>
    <ex:dataPropertyCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</ex:dataPropertyCount>
    <ex:disjointnessAxiomCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">74</ex:disjointnessAxiomCount>
    <ex:domainRangeConstraintCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">76</ex:domainRangeConstraintCount>
    <ex:ruleCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</ex:ruleCount>
  </rdf:Description>
